# ---- Required for live results ----
# Qloo hackathon key (from your Qloo welcome email)
QLOO_API_KEY=
QLOO_BASE_URL=https://hackathon.api.qloo.com

# Ticketmaster Discovery API key (free: developer.ticketmaster.com -> My Apps -> Consumer Key)
TICKETMASTER_API_KEY=

# OpenRouter key (openrouter.ai/keys). Pick a current model that supports tool calling:
# https://openrouter.ai/models?supported_parameters=tools
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
# Optional comma-separated backup models OpenRouter will try if the main one fails
OPENROUTER_FALLBACK_MODELS=

# ---- Optional ----
# Public URL of your deployment (used for OpenRouter attribution and share links)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
# Shared cache across serverless instances (free tier at upstash.com). Leave blank to use in-memory cache.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
# Raise the public limit on live tour plans per visitor (default 8 per 10 minutes; no limit in local dev)
RATE_LIMIT_PER_10MIN=
# Microsoft Clarity project (recordings + heatmaps). Defaults to the Route Scout project; set to off to disable.
NEXT_PUBLIC_CLARITY_ID=ywy02mk063
